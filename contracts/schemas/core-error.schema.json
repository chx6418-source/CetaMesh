{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cetamesh:protocols:proposed:core-error:1.0",
  "title": "CetaMesh PROPOSED core-error v1 — not a current wire schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "validation",
        "protocol",
        "auth",
        "policy",
        "permission",
        "unavailable",
        "resource",
        "execution",
        "data",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "retryable": {
      "type": "boolean"
    },
    "effectState": {
      "type": "string",
      "enum": [
        "not-applicable",
        "no-effect",
        "completed",
        "outcome-unknown"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  },
  "required": [
    "code",
    "category",
    "message",
    "retryable",
    "effectState",
    "correlationId"
  ]
}
