{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cetamesh:protocols:proposed:plugin-capability-binding:1.0",
  "title": "PROPOSED Plugin Capability Descriptor; not current Manifest v1 schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "contractVersion",
    "effectClass",
    "risk",
    "hostKind",
    "inputSchema",
    "outputSchema",
    "dataClasses"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^extension\\.[a-z0-9][a-z0-9._-]{1,63}\\.[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "effectClass": {
      "enum": [
        "read-only",
        "idempotent-write",
        "conditional-write",
        "non-idempotent",
        "unknown"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        "forbidden"
      ]
    },
    "hostKind": {
      "enum": [
        "data-pack",
        "extension-process",
        "managed-app-service",
        "isolated-system-device"
      ]
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "dataClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "public",
          "internal",
          "confidential",
          "restricted"
        ]
      }
    },
    "maxResultBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    }
  }
}
