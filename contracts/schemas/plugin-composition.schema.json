{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cetamesh:protocols:proposed:plugin-composition:1.0",
  "title": "PROPOSED Plugin Composition Sidecar v1; not Extension v1 wire or runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compositionVersion",
    "rootPlugin",
    "rootVersion",
    "components",
    "bindings"
  ],
  "properties": {
    "compositionVersion": {
      "const": 1
    },
    "rootPlugin": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "rootVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "parent",
          "pluginId",
          "version",
          "mode",
          "required"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "parent": {
            "type": "string",
            "pattern": "^(?:root|[a-z][a-z0-9_-]{0,31})$"
          },
          "pluginId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "mode": {
            "enum": [
              "embedded",
              "external"
            ]
          },
          "packagePath": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.?/)(?!/)(?!.*\\\\)(?!.*//)[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*$",
            "maxLength": 250
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "embedded"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "required": [
                "packagePath",
                "sha256"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "external"
                }
              },
              "required": [
                "mode"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "packagePath"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "targetCapability",
          "purpose",
          "dataClass"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^(?:root|[a-z][a-z0-9_-]{0,31})$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "targetCapability": {
            "type": "string",
            "pattern": "^extension\\.[a-z0-9][a-z0-9._-]{1,63}\\.[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "dataClass": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        }
      }
    }
  }
}
