{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cetamesh:protocols:proposed:plugin-event-subscription:1.0",
  "title": "PROPOSED Plugin Event Subscription Intent; never a grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourcePlugin",
    "subscriberPlugin",
    "eventType",
    "contractVersion",
    "purpose",
    "maxInFlight",
    "ttlSeconds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourcePlugin": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "subscriberPlugin": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "maxInFlight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 86400
    },
    "filters": {
      "type": "object",
      "maxProperties": 16
    }
  }
}
