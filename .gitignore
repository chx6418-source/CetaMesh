# Dependencies
node_modules/
.npm-cache/

# Bundled local binaries (ffmpeg, portable git, etc.) —— 锚定仓库根目录，
# 不要写成 `tools/`：那会连带忽略任意层级下的 tools 目录（例如
# design-demos/bg-ripple/tools/ 的融合工具链与校验夹具，那些是要入库的）
/tools/

# Optional SnowLuma runtime installed/detected by the local service manager
/SnowLuma/
/SnowLuma-v*/

# Runtime state and local config (never publish)
state/
config.json
*.log
*.bak
*.bak-*

# dsh-vision-router 插件在工作目录下写的运行产物（agent cwd = 仓库根时会出现）
.dsh-vision-router/
# ZCode 客户端本地会话/计划目录
.zcode/

# 登录页视觉方案样品（10 套整体方案 + 方案 09 的涟漪转场变体 + 演示视频）：
# 已选定「柔光浮雕 + 静水浮升」落地到 public/token-login.html，其余仅作本机参考资料保留，
# 不入库（含约 24MB 视频，避免占用仓库空间）。目录仍在磁盘上，用 serve.mjs 预览。
design-demos/login-proposals/

# Local development / planning / research docs (not part of public project)
/PROJECT_GUIDE.md
/ARCH_REVIEW.md
/DSH_QQ_TOOLS_PLAN.md
/GEN2_SIMULATION_PLAN.md
/SOCIAL_MODE_PLAN.md
/RESEARCH_QQ_MESSAGE_DND.md
/RESEARCH_SNOWLUMA_EMOJI_STICKER.md
/SnowLuma功能调研.md
/真人语感策略.md

# Local one-off dev/debug/patch scripts (contain machine-specific paths/IDs)
/scripts/cleanup-test-sessions.mjs
/scripts/debug-whitelist.mjs
/scripts/patch-qq-chat-v2-collect-memory.mjs
/scripts/patch-qq-chat-v2-presleep.mjs
/scripts/patch-qq-chat-v2-stickers.mjs
/scripts/patch-web-mcp-timeout.mjs

# UI design demos archive (unselected proposals, local reference only)
/design-demos/archive/
