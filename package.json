{
  "name": "CetaMeshMobile",
  "version": "0.0.1",
  "private": true,
  "nitroSQLite": {
    "threadSafe": true
  },
  "scripts": {
    "android": "react-native run-android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test:architecture": "node scripts/check-architecture-boundaries.cjs && node --test scripts/check-architecture-boundaries.test.cjs",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:architecture && npm run test:unit"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "12.0.2",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-blob-util": "0.25.1",
    "react-native-image-picker": "8.2.1",
    "react-native-keychain": "10.0.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-sqlite": "^10.1.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "CetaDeviceIdentitySpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.cetameshmobile.identity"
    },
    "ios": {
      "modulesProvider": {
        "CetaDeviceIdentity": "RCTCetaDeviceIdentity",
        "CetaQrScanner": "RCTCetaQrScanner",
        "CetaPairingTransport": "RCTCetaPairingTransport",
        "CetaCameraCapture": "RCTCetaCameraCapture",
        "CetaMicrophoneRecord": "RCTCetaMicrophoneRecord",
        "CetaNotificationSend": "RCTCetaNotificationSend"
      }
    }
  }
}
