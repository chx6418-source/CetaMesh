+/* ---------- 十款主题：紧凑入口，菜单内预览 ---------- */
+.theme-switch { position: relative; flex: none; }
+.theme-trigger {
+  display: inline-flex; align-items: center; gap: 8px; min-height: 34px;
+  padding: 5px 11px; border: 1px solid var(--border-soft); border-radius: 999px;
+  background: var(--input-bg); color: var(--text); font: inherit; font-size: 12px;
+  cursor: pointer; white-space: nowrap;
+}
+.theme-trigger::after { content: "⌄"; color: var(--text-3); font-size: 15px; line-height: 1; }
+.theme-trigger:hover { background: var(--hover); }
+.theme-trigger:focus-visible, .theme-menu button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+.theme-menu {
+  position: absolute; top: calc(100% + 9px); right: 0; z-index: 100;
+  display: grid; grid-template-columns: repeat(2, minmax(122px, 1fr)); gap: 5px;
+  width: 282px; max-width: calc(100vw - 20px); max-height: min(420px, 70vh); overflow-y: auto;
+  padding: 9px; border: 1px solid var(--border); border-radius: 16px;
+  background: var(--panel-solid); box-shadow: 0 14px 35px var(--shadow-c1);
+  backdrop-filter: blur(var(--glass-blur));
+}
+.theme-menu[hidden] { display: none; }
+.theme-menu button {
+  display: flex; align-items: center; gap: 9px; min-width: 0; padding: 9px;
+  border: 1px solid transparent; border-radius: 10px; background: transparent;
+  color: var(--text-2); font: inherit; font-size: 12px; text-align: left; cursor: pointer;
+}
+.theme-menu button:hover, .theme-menu button.active { background: var(--accent-soft); color: var(--text); }
+.theme-menu button.active { border-color: var(--accent); font-weight: 600; }
+.theme-swatch { width: 17px; height: 17px; flex: none; border-radius: 50%; background: var(--sw); border: 1px solid rgba(125, 125, 125, .3); }
+
+/* 页面快照过渡：色块扩散、侧向轻推、安静淡入三种动作匹配各款风格。 */
+::view-transition-old(root) { animation: themeOld .32s ease both; }
+::view-transition-new(root) { animation: themeNew .36s cubic-bezier(.22, .8, .25, 1) both; }
+html[data-theme-motion="bloom"]::view-transition-new(root) { animation: themeBloom .42s ease-out both; }
+html[data-theme-motion="slide"]::view-transition-new(root) { animation: themeSlide .38s cubic-bezier(.22, .8, .25, 1) both; }
+@keyframes themeOld { to { opacity: .6; } }
+@keyframes themeNew { from { opacity: 0; } }
+@keyframes themeBloom { from { clip-path: circle(0% at 88% 8%); } to { clip-path: circle(150% at 88% 8%); } }
+@keyframes themeSlide { from { clip-path: inset(0 0 0 100%); } to { clip-path: inset(0); } }
+@media (prefers-reduced-motion: reduce) {
+  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .01ms !important; }
 }
 
